{
  "name": "@tamari/e2e",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "test": "playwright test",
    "lint": "eslint .",
    "test:smoke": "playwright test --project=chromium-smoke",
    "test:journeys": "playwright test --project=chromium-journeys",
    "test:local": "playwright test --config=playwright.local.config.ts",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "shots:mobile": "node mobile-screenshots.mjs",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "monocart-reporter": "^2.12.6"
  }
}
