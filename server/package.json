    "@jimp/plugin-resize": "^1.6.1",
    "@libsql/client": "^0.17.3",
    "@tamari/types": "^0.1.0",
    "dompurify": "^3.2.6",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "js-base64": "^3.7.8",
    "jsdom": "^29.1.1",
    "marked": "^18.0.2",
    "mime-types": "^3.0.2",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "png-chunk-text": "^1.0.0",
    "png-chunks-extract": "^1.0.0",
