{
  "name": "@tamari/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc && rm -rf dist/db/migrations && mkdir -p dist/db && cp -r src/db/migrations dist/db/",
