    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/png-chunk-text": "^1.0.3",
    "@types/png-chunks-extract": "^1.0.2",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^4.1.7",
    "supertest": "^7.2.2",
