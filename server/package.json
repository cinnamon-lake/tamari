    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@jimp/core": "^1.6.1",
    "@jimp/js-gif": "^1.6.1",
